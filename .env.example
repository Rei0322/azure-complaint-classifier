# Copy this file to .env and fill in your values. .env is ignored by git.
#
# Endpoint: use the resource's Azure OpenAI endpoint, e.g.
#   https://<resource-name>.openai.azure.com/
# Do NOT use the Foundry project URL (https://<name>.services.ai.azure.com/api/projects/...),
# which returns "API version not supported".
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>

# Deployment names (match the names in your Foundry project)
WHISPER_DEPLOYMENT=whisper
DALLE_DEPLOYMENT=gpt-image-1-mini
GPT_DEPLOYMENT=gpt-4o

# API versions (optional; these are the defaults)
WHISPER_API_VERSION=2025-04-01-preview
DALLE_API_VERSION=2025-04-01-preview
GPT_API_VERSION=2025-04-01-preview
